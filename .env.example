# Copy to .env, fill values, then explicitly source your trusted file before Mix.
DB_HOST=localhost
DB_PORT=5434
PORT=4000
# Optional existing development database; overrides DB_HOST/DB_PORT in dev:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/file_server_v2

# SMTP: EMAIL is the Gmail login and default sender address.
# For Gmail, use an app password rather than the normal account password.
EMAIL=
EMAIL_PASSWORD=
EMAIL_FROM="File Server"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional different verified sender address (EMAIL_FROM is the display name):
# EMAIL_FROM_ADDRESS=verified-sender@example.com

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register this exact callback in the GitHub OAuth application's settings:
# GITHUB_REDIRECT_URI=http://localhost:4000/auth/user/github/callback

# Accepted by the vault; base64-encoded 32-byte key. Required in production.
# CLOAK_KEY is also supported and takes precedence when nonempty.
STORAGE_ENCRYPTION_KEY=

# Optional: select S3 from server environment in an application's storage settings.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=serve
S3_REGION=ap-northeast-1
S3_ENDPOINT=https://s3.ap-northeast-1.idrivee2.com
MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_MAX_FILE_SIZE=50
# Private local uploads; keep this directory outside public/static assets.
# LOCAL_STORAGE_PATH=/var/lib/file-server/storage
# Explicitly allow a custom endpoint host, e.g. a private MinIO service:
# S3_ALLOWED_HOSTS=minio.example.internal

# Additional production settings:
# SECRET_KEY_BASE=generate-with-mix-phx.gen.secret
# TOKEN_SIGNING_SECRET=generate-with-mix-phx.gen.secret
# PHX_HOST=files.example.com
# PHX_SERVER=true

# Account storage: default quota for newly created quota rows (all applications combined).
# Existing accounts keep their stored limit; operator changes use account_storage.quota_bytes.
STORAGE_QUOTA_GB=5
# Image worker limits. Original uploads remain unchanged.
IMAGE_PROCESSING_TIMEOUT_MS=10000
IMAGE_MAX_INPUT_PIXELS=40000000
IMAGE_MAX_OUTPUT_BYTES=5242880
