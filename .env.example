# Copy to .env and source it explicitly from your trusted shell. Never commit .env.
# Local Compose defaults (development/test fixture service):
DB_HOST=localhost
DB_PORT=5434
PORT=4000
MAIL_FROM=noreply@example.com
# Existing dev database instead of Compose (overrides DB_HOST/DB_PORT in dev):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/file_server_v2
# Optional GitHub OAuth (register this exact callback with GitHub):
# GITHUB_CLIENT_ID=your-client-id
# GITHUB_CLIENT_SECRET=your-client-secret
# GITHUB_REDIRECT_URI=http://localhost:4000/auth/user/github/callback
# Production settings:
# DATABASE_URL=ecto://USER:PASSWORD@HOST/app_prod
# SECRET_KEY_BASE=generate-with-mix-phx.gen.secret
# TOKEN_SIGNING_SECRET=generate-with-mix-phx.gen.secret
# CLOAK_KEY=base64-encoded-32-random-bytes
# PHX_HOST=files.example.com
# PHX_SERVER=true
# MAILGUN_API_KEY=your-key
# MAILGUN_DOMAIN=mg.example.com
