<Layouts.auth flash={@flash}>
  <div class="mb-7 text-center">
    <span class="mx-auto mb-5 flex size-11 items-center justify-center rounded-xl border border-border bg-muted/50"><.icon
      name="hero-envelope"
      class="size-5"
    /></span>
    <h1 class="text-2xl font-semibold tracking-tight">Check your inbox</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">
      If sign-in is available, we've sent a code to<br /><strong class="font-medium text-foreground">{@email}</strong>.
    </p>
  </div>
  <.form for={to_form(%{})} id="otp-verify" action="/sign-in/otp/verify" class="space-y-4">
    <.input
      id="otp-code"
      class="ui-input auth-code"
      name="code"
      type="text"
      label="Six-digit code"
      inputmode="numeric"
      autocomplete="one-time-code"
      minlength="6"
      maxlength="6"
      pattern="[0-9]{6}"
      placeholder="000000"
      required
    />
    <p :if={@error} role="alert" class="text-sm text-destructive">{@error}</p>
    <.button type="submit" class="w-full">Verify and sign in</.button>
  </.form>
  <p class="mt-6 text-center text-xs leading-5 text-muted-foreground">
    Valid for 10 minutes. Need a new code?<br />Wait 60 seconds, then <.link
      href="/sign-in"
      class="text-foreground underline underline-offset-4"
    >try again</.link>.
  </p>
</Layouts.auth>
