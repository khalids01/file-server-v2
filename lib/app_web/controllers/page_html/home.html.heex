<Layouts.app flash={@flash}>
  <section class="relative mx-auto grid max-w-7xl items-center gap-14 px-6 py-20 lg:grid-cols-2 lg:px-10 lg:py-28">
    <div>
      <p class="mb-7 inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700">
        <span class="size-1.5 rounded-full bg-indigo-500"></span> THE NEXT CHAPTER OF SERVE
      </p>
      <h1 class="max-w-xl text-5xl font-semibold leading-[1.08] tracking-[-0.045em] text-slate-950 sm:text-6xl lg:text-7xl">
        Your files deserve<br />a better <span class="text-indigo-600">home.</span>
      </h1>
      <p class="mt-7 max-w-lg text-lg leading-8 text-slate-500">
        A fresh foundation for your self-hosted file platform. Secure sign-in, isolated workspaces, and application keys — built to put you in control.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <.link
          id="landing-get-started"
          href="/register"
          class="inline-flex items-center gap-3 rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-600/15 transition hover:-translate-y-0.5 hover:bg-indigo-700"
        >Create your workspace <.icon name="hero-arrow-right" class="size-4" /></.link>
        <.link
          href="/sign-in"
          class="rounded-xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400"
        >Explore your dashboard</.link>
      </div>
      <div class="mt-8 flex flex-wrap gap-5 text-xs font-medium text-slate-400">
        <span>Open source</span><span>Self hosted</span><span>Phoenix + Ash</span>
      </div>
    </div>
    <div class="relative rounded-3xl bg-gradient-to-br from-indigo-100 via-slate-100 to-violet-100 p-5 sm:p-8">
      <div class="overflow-hidden rounded-2xl border border-white bg-white shadow-2xl shadow-indigo-900/10">
        <div class="flex items-center gap-1.5 border-b border-slate-100 px-5 py-4">
          <span class="size-2 rounded-full bg-rose-300"></span><span class="size-2 rounded-full bg-amber-300"></span><span class="size-2 rounded-full bg-emerald-300"></span><span class="ml-4 text-[10px] font-medium text-slate-400">serve / workspace preview</span>
        </div>
        <div class="p-6 sm:p-8">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold tracking-tight">A place for every project.</h2><.icon
              name="hero-squares-2x2"
              class="size-5 text-indigo-400"
            />
          </div>
          <p class="mt-2 text-sm text-slate-400">One account. Clear boundaries.</p>
          <div
            :for={
              {name, icon, color} <- [
                {"Your workspace", "hero-building-office-2", "bg-indigo-50 text-indigo-600"},
                {"Your applications", "hero-code-bracket", "bg-emerald-50 text-emerald-600"},
                {"Your access keys", "hero-key", "bg-amber-50 text-amber-600"}
              ]
            }
            class="mt-4 flex items-center gap-4 rounded-xl border border-slate-100 p-4"
          >
            <span class={["flex size-10 items-center justify-center rounded-xl", color]}><.icon
              name={icon}
              class="size-5"
            /></span><span class="text-sm font-semibold text-slate-700">{name}</span><.icon
              name="hero-check-circle-solid"
              class="ml-auto size-5 text-slate-200"
            />
          </div>
          <div class="mt-6 flex items-center gap-2 text-xs text-slate-400">
            <span class="size-2 rounded-full bg-emerald-400"></span>
            Workspace & authentication MVP
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="border-y border-slate-200 bg-white px-6 py-14">
    <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-3">
      <div :for={
        {icon, title, text} <- [
          {"hero-finger-print", "Sign in your way",
           "Email codes, passwords, magic links, or configured GitHub authentication."},
          {"hero-building-office-2", "Keep projects separate",
           "Create workspaces and applications with server-enforced tenant boundaries."},
          {"hero-key", "Access with intention",
           "Issue application keys with explicit scopes, expiry, and immediate revocation."}
        ]
      }>
        <.icon name={icon} class="mb-4 size-7 text-indigo-500" /><h2 class="text-base font-semibold">
          {title}
        </h2><p class="mt-3 text-sm leading-7 text-slate-500">{text}</p>
      </div>
    </div>
  </section>
  <footer class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-xs text-slate-400">
    <span>Serve v2 · Built for ownership.</span><span>File storage, transfers & v1 migration are on the roadmap.</span>
  </footer>
</Layouts.app>
