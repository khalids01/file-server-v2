<Layouts.auth flash={@flash}>
  <h1 class="text-2xl font-semibold tracking-tight">Reset your password</h1>
  <p class="mb-7 mt-3 text-sm leading-6 text-slate-500">
    Enter your email. If an eligible account exists, we'll send a reset link.
  </p>
  <.form
    for={to_form(%{}, as: :user)}
    id="password-reset-request"
    action="/auth/user/password/reset_request"
    class="space-y-4"
  >
    <.input name="user[email]" type="email" label="Email address" autocomplete="email" required />
    <.button class="w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white hover:bg-indigo-700">Send reset link</.button>
  </.form>
  <.link href="/sign-in" class="mt-6 block text-center text-sm text-indigo-600">Back to sign in</.link>
</Layouts.auth>
