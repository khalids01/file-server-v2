<Layouts.app flash={@flash} current_user={@current_user} section={section(@live_action)}>
  <div id="dashboard-heading" class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">
        {if @selected_app, do: @selected_app.name, else: section(@live_action)}
      </h1>
      <p class="mt-2 text-sm text-muted-foreground">
        {case @live_action do
          :applications -> "Manage your file storage applications and their settings"
          :application -> "Manage this application's settings and API access"
          :profile -> "Manage your personal information and account"
          _ -> "Your applications and account at a glance"
        end}
      </p>
    </div>
    <.button
      :if={@live_action in [:overview, :applications]}
      id="new-application"
      phx-click="new_application"
    >
      <.icon name="hero-plus" />New Application
    </.button>
    <.button :if={@selected_app} navigate={~p"/dashboard/applications"} variant="outline">Back to applications</.button>
  </div>

  <section :if={@live_action == :overview} class="space-y-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <.card class="p-6">
        <p class="text-sm text-muted-foreground">Applications</p><p class="mt-4 text-3xl font-semibold">
          {@account_insights.application_count}
        </p>
      </.card>
      <.card class="p-6">
        <p class="text-sm text-muted-foreground">API keys</p><p class="mt-4 text-3xl font-semibold">
          {Enum.sum(Map.values(@key_counts))}
        </p>
      </.card>
    </div>
    <div :if={@account_insights} id="account-usage-summary" class="grid gap-4 sm:grid-cols-3">
      <.card class="p-6">
        <p class="text-sm text-muted-foreground">Stored files</p><p class="mt-2 text-2xl font-semibold">
          {@account_insights.totals.files}
        </p>
      </.card>
      <.card class="p-6">
        <p class="text-sm text-muted-foreground">Account storage</p><p class="mt-2 text-2xl font-semibold">
          {format_bytes(@account_insights.quota.used_bytes)}
        </p><p class="mt-1 text-xs text-muted-foreground">
          {format_bytes(@account_insights.quota.reserved_bytes)} reserved · {format_bytes(
            @account_insights.quota.quota_bytes
          )} quota
        </p>
      </.card>
      <.card class="p-6">
        <p class="text-sm text-muted-foreground">Needs attention</p><p class="mt-2 text-2xl font-semibold">
          {@account_insights.totals.image_failed + @account_insights.totals.cleanup_pending}
        </p><p class="mt-1 text-xs text-muted-foreground">
          Open an application's Usage &amp; recovery tab.
        </p>
      </.card>
    </div>
    <.card class="p-7">
      <h2 class="text-lg font-semibold">Everything starts with an application</h2><p class="mt-2 text-sm text-muted-foreground">
        Organize your projects and manage their API keys in one place.
      </p><.button navigate={~p"/dashboard/applications"} variant="outline" class="mt-5">Manage applications</.button>
    </.card>
  </section>

  <section :if={@live_action == :applications}>
    <.card :if={@applications == []} id="applications-empty" class="py-12 text-center">
      <.icon name="hero-folder-open" class="mx-auto mb-4 size-12 text-muted-foreground" />
      <h2 class="mb-2 text-lg font-semibold">No applications yet</h2>
      <p class="mb-6 text-sm text-muted-foreground">
        Create your first application to start organizing and managing your files.
      </p>
      <.button phx-click="new_application"><.icon name="hero-plus" />Create First Application</.button>
    </.card>
    <div
      id="applications"
      phx-update="stream"
      class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"
    >
      <.card
        :for={{dom_id, app} <- @streams.applications}
        id={dom_id}
        class="p-6 transition-shadow hover:shadow-md"
      >
        <div class="flex items-center justify-between gap-3">
          <span class="flex size-10 items-center justify-center rounded-lg bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-400"><.icon
            name="hero-folder-open"
            class="size-5"
          /></span>
          <.badge>{app.slug}</.badge>
        </div>
        <h2 class="mt-4 truncate text-xl font-semibold">{app.name}</h2>
        <div class="my-4 flex justify-between gap-2 text-sm text-muted-foreground">
          <span>{Map.get(@file_counts, app.id, 0)} files</span><span>{Map.get(
            @key_counts,
            app.id,
            0
          )} API keys</span>
        </div>
        <p class="mb-4 text-xs text-muted-foreground">
          {format_bytes(get_in(@account_insights.applications, [app.id, :original_bytes]) || 0)} originals · {format_bytes(
            get_in(@account_insights.applications, [app.id, :variant_bytes]) || 0
          )} previews
        </p>
        <div class="flex flex-wrap gap-2">
          <.button
            navigate={~p"/dashboard/applications/#{app.id}?tab=usage"}
            variant="outline"
            aria-label={"Usage for " <> app.name}
          ><.icon name="hero-chart-bar" />Usage</.button>
          <.button
            navigate={~p"/dashboard/applications/#{app.id}"}
            variant="outline"
            class="flex-1"
          ><.icon name="hero-cog-6-tooth" />Manage</.button>
          <.button
            navigate={~p"/dashboard/applications/#{app.id}?tab=keys"}
            variant="outline"
            aria-label={"API keys for " <> app.name}
            title="API keys"
          ><.icon name="hero-key" /></.button>
          <.button
            navigate={~p"/dashboard/applications/#{app.id}?tab=files"}
            variant="outline"
            aria-label={"Files for " <> app.name}
            title="Files"
          ><.icon name="hero-arrow-up-tray" /></.button>
        </div>
      </.card>
    </div>
  </section>

  <section :if={@selected_app} class="space-y-6">
    <nav
      class="flex flex-wrap gap-1 rounded-lg border border-border bg-muted p-1"
      aria-label="Application sections"
    >
      <.button
        :for={
          {title, tab} <- [
            {"Settings", "settings"},
            {"API keys", "keys"},
            {"Files", "files"},
            {"Usage & recovery", "usage"}
          ]
        }
        patch={~p"/dashboard/applications/#{@selected_app.id}?tab=#{tab}"}
        variant={if @tab == tab, do: "secondary", else: "ghost"}
        aria-current={if @tab == tab, do: "page"}
      >{title}</.button>
    </nav>
    <section :if={@tab == "usage" && @app_insights} id="application-usage" class="space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-semibold">Usage &amp; recovery</h2><p class="mt-1 text-sm text-muted-foreground">
            Live storage records for this application. Updates every 3 seconds.
          </p>
        </div><.button
          patch={~p"/dashboard/applications/#{@selected_app.id}?tab=files"}
          variant="outline"
        >Open files</.button>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <.card class="p-5">
          <p class="text-sm text-muted-foreground">Stored files</p><p
            id="usage-file-count"
            class="mt-2 text-2xl font-semibold"
          >
            {@app_insights.metrics.files}
          </p>
        </.card>
        <.card class="p-5">
          <p class="text-sm text-muted-foreground">Originals</p><p
            id="usage-original-bytes"
            class="mt-2 text-2xl font-semibold"
          >
            {format_bytes(@app_insights.metrics.original_bytes)}
          </p>
        </.card>
        <.card class="p-5">
          <p class="text-sm text-muted-foreground">Generated previews</p><p
            id="usage-variant-bytes"
            class="mt-2 text-2xl font-semibold"
          >
            {format_bytes(@app_insights.metrics.variant_bytes)}
          </p>
        </.card>
        <.card class="p-5">
          <p class="text-sm text-muted-foreground">Reserved bytes</p><p
            id="usage-reserved-bytes"
            class="mt-2 text-2xl font-semibold"
          >
            {format_bytes(@app_insights.metrics.reserved_bytes)}
          </p>
        </.card>
      </div>
      <.card class="p-5">
        <h3 class="font-semibold">Processing &amp; cleanup</h3><div class="mt-3 flex flex-wrap gap-3 text-sm">
          <.badge id="usage-image-pending">
            {@app_insights.metrics.image_pending} images queued / processing
          </.badge><.badge id="usage-image-failed">
            {@app_insights.metrics.image_failed} image failures
          </.badge><.badge id="usage-cleanup-pending">
            {@app_insights.metrics.cleanup_pending} awaiting recovery
          </.badge><.badge>{@app_insights.metrics.upload_pending} pending uploads</.badge>
        </div><p class="mt-3 text-xs text-muted-foreground">
          These are your file lifecycle states. Originals and ready previews count toward the shared account quota; reservations remain until confirmed cleanup.
        </p>
      </.card>
      <.card class="p-5">
        <h3 class="font-semibold">Needs attention</h3><p
          :if={@app_insights.issues == []}
          id="usage-no-issues"
          class="mt-3 text-sm text-muted-foreground"
        >
          No file issues need attention.
        </p><p :if={@app_insights.issues != []} class="mt-2 text-xs text-muted-foreground">
          Showing up to 25 oldest issues. Automatic recovery also runs in the background.
        </p><div id="storage-issues" class="mt-3 divide-y divide-border">
          <div
            :for={issue <- @app_insights.issues}
            id={"storage-issue-#{issue.id}"}
            class="flex flex-wrap items-center justify-between gap-3 py-4"
          >
            <div class="min-w-0">
              <p class="break-all text-sm font-medium">{issue.filename}</p><p class="mt-1 text-sm">
                {issue.kind}
              </p><p class="mt-1 max-w-2xl text-xs text-muted-foreground">{issue.message}</p><p class="mt-1 text-xs text-muted-foreground">
                Cleanup attempts: {issue.attempts}
              </p>
            </div><.button
              type="button"
              variant="outline"
              phx-click="retry_storage_issue"
              phx-value-id={issue.id}
              phx-disable-with="Queueing…"
            >Retry recovery</.button>
          </div>
        </div>
      </.card>
      <.card id="operations-guidance" class="p-5">
        <h3 class="font-semibold">Before production</h3><p class="mt-2 text-sm text-muted-foreground">
          Back up PostgreSQL, persistent local files and your encryption keys separately. Keep S3 bucket backups/versioning with your storage provider. Restore into an isolated environment before relying on a backup.
        </p><p class="mt-2 text-xs text-muted-foreground">
          Backups are operator-managed and cannot be created here. Ask your server operator when the last restore was tested.
        </p>
      </.card>
    </section>
    <.card :if={@tab == "settings"} class="p-7">
      <h2 class="mb-5 text-lg font-semibold">Application settings</h2>
      <.form
        for={to_form(%{}, as: :application)}
        id="application-settings"
        phx-submit="update_application"
        class="space-y-4"
      >
        <.input
          name="application[name]"
          label="Application name"
          value={@selected_app.name}
          required
          minlength="2"
          maxlength="80"
        />
        <.input name="slug" label="Slug" value={@selected_app.slug} readonly />
        <.select
          id="application-storage"
          name="application[storage_connection_id]"
          label="Default storage destination"
          value={@selected_app.storage_connection_id || "local"}
          options={storage_options(@connections, @environment_s3?)}
        />
        <p class="text-xs text-muted-foreground">
          New uploads use this destination. Existing files stay in their original location.
        </p>
        <.button>Save changes</.button>
      </.form>
      <div class="mt-6 flex flex-wrap gap-2 border-t border-border pt-5">
        <.button
          id="test-storage"
          type="button"
          variant="outline"
          phx-click="test_storage"
          disabled={@testing_storage}
        ><.icon name="hero-signal" />{if @testing_storage,
          do: "Testing…",
          else: "Test current storage"}</.button>
        <.button id="connect-s3" type="button" variant="outline" phx-click="new_storage"><.icon name="hero-cloud" />Connect S3 storage</.button>
      </div>
      <p class="mt-3 text-xs text-muted-foreground">
        Local files are private on this server. S3 credentials are encrypted and never sent back to the browser.
      </p>
    </.card>
    <div :if={@tab == "files"} class="space-y-6">
      <.card class="p-7">
        <h2 class="mb-2 text-lg font-semibold">Upload files</h2>
        <p class="mb-5 text-sm text-muted-foreground">
          Destination: {storage_label(@connections, @selected_app.storage_connection_id)}
        </p>
        <.form
          for={to_form(%{})}
          id="upload-files"
          phx-change="validate_files"
          phx-submit="upload_files"
          class="space-y-4"
        >
          <.file_upload
            upload={@uploads.documents}
            max_mb={div(App.Storage.max_file_size(), 1024 * 1024)}
          />
          <.button
            id="upload-files-button"
            phx-disable-with="Uploading…"
            disabled={@uploads.documents.entries == [] || upload_errors(@uploads.documents) != []}
          >Upload files</.button>
        </.form>
        <ul
          :if={@upload_results != []}
          id="upload-results"
          class="mt-4 space-y-2"
          aria-live="polite"
        >
          <li
            :for={{result, index} <- Enum.with_index(@upload_results)}
            id={"upload-result-#{index}"}
            class="rounded-md border border-border p-3 text-sm"
          >
            <span class="font-medium">{result.name}</span>
            · {upload_result(result.result)}
            <.button
              :if={!match?({:ok, _}, result.result)}
              type="button"
              variant="ghost"
              phx-click="retry_upload"
            >Retry: reselect file</.button>
          </li>
        </ul>
      </.card>
      <.card :if={@storage_usage} class="p-5" id="account-storage-usage">
        <p class="text-sm font-medium">Account storage</p>
        <p class="mt-1 text-xs text-muted-foreground">
          {format_bytes(@storage_usage.used_bytes)} used · {format_bytes(
            @storage_usage.reserved_bytes
          )} reserved · {format_bytes(@storage_usage.quota_bytes)} total across all applications
        </p>
      </.card>
      <.card class="p-7">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold">Files</h2><span class="text-xs text-muted-foreground">
            {if @file_total == 1, do: "1 file", else: "#{@file_total} files"} · Private downloads
          </span>
        </div>
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
          <div
            class="inline-flex gap-1 rounded-lg border border-border p-1"
            role="group"
            aria-label="File view"
          >
            <.button
              id="files-view-list"
              type="button"
              variant={if @file_view == "list", do: "default", else: "ghost"}
              aria-pressed={to_string(@file_view == "list")}
              phx-click="file_view"
              phx-value-view="list"
            ><.icon name="hero-list-bullet" />List</.button>
            <.button
              id="files-view-grid"
              type="button"
              variant={if @file_view == "grid", do: "default", else: "ghost"}
              aria-pressed={to_string(@file_view == "grid")}
              phx-click="file_view"
              phx-value-view="grid"
            ><.icon name="hero-squares-2x2" />Grid</.button>
          </div>
          <div :if={@files != []} class="flex flex-wrap items-center gap-2">
            <.button id="select-page" type="button" variant="ghost" phx-click="select_page">Select page</.button>
            <.button
              :if={MapSet.size(@selected_files) > 0}
              id="clear-selection"
              type="button"
              variant="ghost"
              phx-click="clear_selection"
            >Clear</.button>
          </div>
        </div>
        <div
          :if={MapSet.size(@selected_files) > 0}
          id="file-bulk-toolbar"
          class="mb-5 flex flex-wrap items-center gap-3 rounded-lg border border-border bg-muted/40 p-3"
        >
          <span id="selected-file-count" class="text-sm font-medium">{MapSet.size(@selected_files)} selected</span>
          <.button
            id="bulk-tags-button"
            type="button"
            variant="outline"
            phx-click="open_bulk"
            phx-value-action="tags"
          ><.icon name="hero-tag" />Edit tags</.button>
          <.button
            id="bulk-delete-button"
            type="button"
            variant="destructive"
            phx-click="open_bulk"
            phx-value-action="delete"
          ><.icon name="hero-trash" />Delete selected</.button>
        </div>
        <p :if={@bulk_feedback} id="bulk-feedback" role="status" class="mb-4 text-sm">
          {@bulk_feedback}. Failed files remain selected for retry.
        </p>
        <ul
          :if={@bulk_errors != []}
          id="bulk-errors"
          class="mb-4 space-y-1 text-sm text-destructive"
          aria-live="polite"
        >
          <li :for={error <- @bulk_errors}>{error.name}: {error.message}</li>
        </ul>
        <.form
          for={to_form(%{}, as: :files)}
          id="file-filters"
          phx-submit="filter_files"
          class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto_auto] sm:items-end"
        >
          <.input
            name="search"
            type="search"
            label="Search filename"
            id="file-search"
            value={@file_search}
            maxlength="200"
            placeholder="Search by filename…"
            autocomplete="off"
          />
          <.input
            name="tags"
            type="textarea"
            label="Filter tags"
            id="file-tag-filters"
            value={Enum.join(@file_tags, "\n")}
            rows="2"
            placeholder="One tag per line"
          />
          <.select
            id="file-sort"
            name="sort"
            label="Sort by"
            value={@file_sort}
            options={[
              {"Newest first", "newest"},
              {"Oldest first", "oldest"},
              {"Name (A–Z)", "name"},
              {"Largest first", "size"}
            ]}
          />
          <.button type="submit" class="mb-2"><.icon name="hero-magnifying-glass" />Apply</.button>
        </.form>
        <p
          :if={@files == [] && (@file_search != "" || @file_tags != [])}
          id="files-search-empty"
          class="py-8 text-center text-sm text-muted-foreground"
        >
          No files match the current filters. Try different search terms or tags.
        </p>
        <p
          :if={@files == [] && @file_search == "" && @file_tags == []}
          id="files-empty"
          class="py-8 text-center text-sm text-muted-foreground"
        >
          No files yet. Upload your first file above.
        </p>
        <div
          id="stored-files"
          phx-update="stream"
          data-view={@file_view}
          class={
            if @file_view == "grid",
              do: "grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3",
              else: "divide-y divide-border"
          }
        >
          <div
            :for={{dom_id, file} <- @streams.files}
            id={dom_id}
            class={
              if @file_view == "grid",
                do:
                  "flex min-w-0 flex-col gap-4 rounded-xl border border-border bg-card p-4 transition-shadow hover:shadow-sm",
                else: "flex flex-wrap items-center justify-between gap-3 py-4"
            }
          >
            <div class={
              if @file_view == "grid",
                do: "flex w-full min-w-0 flex-col gap-3",
                else: "flex min-w-0 items-center gap-3"
            }>
              <.button
                id={"select-file-#{file.id}"}
                type="button"
                variant="ghost"
                class="size-8 shrink-0 p-0"
                role="checkbox"
                aria-checked={to_string(MapSet.member?(@selected_files, file.id))}
                aria-label={"Select " <> file.filename}
                phx-click="toggle_file"
                phx-value-id={file.id}
              >
                <.icon name={
                  if MapSet.member?(@selected_files, file.id),
                    do: "hero-check-circle-solid",
                    else: "hero-stop"
                } />
              </.button>
              <.file_media file={file} view={@file_view} />
              <div class="min-w-0">
                <button
                  id={"file-details-#{file.id}"}
                  type="button"
                  class="break-all text-left text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  phx-click="file_details"
                  phx-value-id={file.id}
                >{file.filename}</button>
                <p
                  :if={file.processing_state != "not_applicable"}
                  id={"processing-#{file.id}"}
                  class="mt-1 text-xs text-muted-foreground"
                >
                  Image: {file.processing_state}{if file.processing_error,
                    do: " · " <> file.processing_error}
                </p>
                <.button
                  :if={file.processing_state == "failed"}
                  type="button"
                  variant="ghost"
                  phx-click="retry_image"
                  phx-value-id={file.id}
                >Retry preview</.button>
                <p class="mt-1 text-xs text-muted-foreground">
                  {format_bytes(file.size)} · {storage_label(@connections, file.connection_id)} · {Calendar.strftime(
                    file.created_at,
                    "%d %b %Y"
                  )}
                </p>
                <div :if={file.tags != []} class="mt-2 flex flex-wrap gap-1">
                  <.badge :for={tag <- file.tags} class="max-w-full break-all whitespace-normal">
                    {tag}
                  </.badge>
                </div>
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <.private_download_link file={file} />
              <.button
                href={~p"/files/#{file.id}/download"}
                variant="outline"
                aria-label={"Download " <> file.filename}
              ><.icon name="hero-arrow-down-tray" />Download</.button><.button
                variant="outline"
                phx-click="edit_file_tags"
                phx-value-id={file.id}
                aria-label={"Edit tags for " <> file.filename}
              ><.icon name="hero-tag" />Tags</.button><.button
                variant="ghost"
                phx-click="delete_file"
                phx-value-id={file.id}
                aria-label={"Delete " <> file.filename}
              ><.icon name="hero-trash" /></.button>
            </div>
          </div>
        </div>
        <nav
          :if={@file_pages > 1}
          id="file-pagination"
          class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4 text-sm"
          aria-label="File pages"
        >
          <.button
            :if={@file_prev}
            patch={@file_prev}
            variant="outline"
            id="file-page-prev"
            aria-label="Previous page"
          ><.icon name="hero-chevron-left" />Previous</.button>
          <span :if={!@file_prev} class="inline-flex"></span>
          <span id="file-page-status" class="text-muted-foreground">
            Page {@file_page} of {@file_pages}
          </span>
          <.button
            :if={@file_next}
            patch={@file_next}
            variant="outline"
            id="file-page-next"
            aria-label="Next page"
          >Next<.icon name="hero-chevron-right" /></.button>
          <span :if={!@file_next} class="inline-flex"></span>
        </nav>
      </.card>
    </div>
    <.card :if={@tab == "keys"} class="p-7">
      <h2 class="text-lg font-semibold">API keys</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Server-side credentials. Keys expire after 30 days. Maximum 100 recent keys shown.
      </p>
      <.form
        for={to_form(%{}, as: :key)}
        id="issue-key"
        phx-submit="issue_key"
        class="mt-6 grid items-end gap-4 sm:grid-cols-[1fr_1fr_auto]"
      >
        <.input
          name="key[name]"
          label="Key name"
          required
          minlength="2"
          maxlength="80"
          placeholder="Development"
        />
        <.input
          name="key[access]"
          label="Access"
          type="select"
          options={[
            {"Read only", "read"},
            {"Read & write", "write"},
            {"Read, write & delete", "manage"}
          ]}
        />
        <.button class="mb-2">Issue key</.button>
      </.form>
      <div
        :if={@plaintext_key}
        id="new-api-key"
        class="mt-5 rounded-xl border border-border bg-warning p-4"
      >
        <p class="mb-2 text-xs font-semibold text-warning-foreground">
          Copy now. This is the only time the complete key is displayed.
        </p><code class="block break-all select-all text-sm text-warning-foreground">{@plaintext_key}</code>
      </div>
      <div id="keys" phx-update="stream" class="mt-6 space-y-2">
        <div
          :for={{dom_id, key} <- @streams.keys}
          id={dom_id}
          class="flex flex-wrap items-center justify-between gap-3 border-t border-border py-4"
        >
          <div>
            <p class="text-sm font-semibold">
              {key.name}
              <span class="font-mono text-xs font-normal text-muted-foreground">…{key.fingerprint}</span>
            </p><p class="mt-1 text-xs text-muted-foreground">
              {Enum.join(key.scopes, ", ")} · {if key.revoked_at,
                do: "Revoked",
                else: "Expires " <> Calendar.strftime(key.expires_at, "%d %b %Y")}
            </p>
          </div><.button
            :if={!key.revoked_at}
            variant="outline"
            phx-click="revoke_key"
            phx-value-id={key.id}
          >Revoke</.button>
        </div>
      </div>
      <p class="mt-5 text-xs leading-6 text-muted-foreground">
        Test with <code>GET /api/v2/application</code>
        and <code>Authorization: Bearer &lt;key&gt;</code>. Use the Files tab for uploads and private downloads. Use this key with the /api/v2/files API for server-side file access.
      </p>
    </.card>
  </section>

  <section :if={@live_action == :profile} class="w-full space-y-6">
    <.card class="p-7">
      <h2 class="mb-5 text-lg font-semibold">Profile</h2>
      <.form
        for={to_form(%{"name" => @current_user.name}, as: :profile)}
        id="profile-form"
        phx-submit="update_profile"
        class="space-y-4"
      >
        <.input
          name="profile[name]"
          label="Display name"
          value={@current_user.name}
          maxlength="80"
        />
        <p class="text-sm text-muted-foreground">{@current_user.email} · Email verified</p><.button>Save profile</.button>
      </.form>
    </.card>
    <.card class="p-7">
      <h2 class="text-lg font-semibold">Account security</h2><p class="mt-3 text-sm text-muted-foreground">
        Sign in with GitHub or a one-time code sent to your email.
      </p><.button href="/sign-in" variant="outline" class="mt-5">Manage sign-in</.button>
    </.card>
  </section>

  <.dialog
    :if={@show_create}
    id="create-application-dialog"
    title="Create New Application"
    description="Create a new application to organize your files and manage API access."
  >
    <.form
      for={to_form(%{}, as: :application)}
      id="create-application"
      phx-submit="create_application"
      class="space-y-4"
    >
      <p :if={@save_error} role="alert" class="text-sm text-destructive">{@save_error}</p>
      <.input
        name="application[name]"
        label="Application Name"
        placeholder="e.g., My Website, Mobile App"
        required
        minlength="2"
        maxlength="80"
      />
      <.input
        name="application[slug]"
        label="Slug (URL identifier)"
        placeholder="e.g., my-website, mobile-app"
        required
        minlength="2"
        maxlength="60"
        pattern="[a-z0-9]+(-[a-z0-9]+)*"
      />
      <p class="text-xs text-muted-foreground">
        Used in API URLs and file paths. Only lowercase letters, numbers, and hyphens.
      </p>
      <div class="flex justify-end gap-2 pt-3">
        <.button type="button" phx-click="close_dialog" variant="outline">Cancel</.button><.button>Create Application</.button>
      </div>
    </.form>
  </.dialog>
  <.dialog
    :if={@revoking_key}
    id="revoke-key-dialog"
    title="Revoke API key?"
    description="Integrations using this key will stop working. You can create a new key later."
  >
    <div class="flex justify-end gap-2">
      <.button variant="outline" phx-click="close_dialog">Cancel</.button><.button
        id="confirm-revoke-key"
        variant="destructive"
        phx-click="confirm_revoke_key"
      >Revoke key</.button>
    </div>
  </.dialog>
  <.dialog
    :if={@show_storage}
    id="storage-connection-dialog"
    title="Connect S3 storage"
    description="Connect Amazon S3, IDrive e2, R2, or another S3-compatible provider. The bucket must already exist."
  >
    <.form
      for={to_form(%{}, as: :storage)}
      id="storage-connection-form"
      phx-submit="create_storage"
      class="space-y-4"
    >
      <p :if={@storage_error} role="alert" class="text-sm text-destructive">{@storage_error}</p>
      <.input
        name="storage[name]"
        label="Connection name"
        placeholder="My IDrive bucket"
        required
        minlength="2"
        maxlength="80"
      />
      <.input
        name="storage[endpoint]"
        label="Endpoint"
        placeholder="https://s3.ap-northeast-1.idrivee2.com"
        required
      />
      <div class="grid gap-4 sm:grid-cols-2">
        <.input name="storage[bucket]" label="Bucket" placeholder="serve" required /><.input
          name="storage[region]"
          label="Region"
          placeholder="ap-northeast-1"
          required
        />
      </div>
      <.input name="storage[access_key_id]" label="Access key ID" autocomplete="off" required />
      <.input
        name="storage[secret_access_key]"
        label="Secret access key"
        type="password"
        autocomplete="off"
        required
      />
      <p class="text-xs text-muted-foreground">
        Path-style requests are used. Custom endpoint hosts require the server's S3_ALLOWED_HOSTS setting.
      </p>
      <div class="flex justify-end gap-2">
        <.button type="button" variant="outline" phx-click="close_dialog">Cancel</.button><.button phx-disable-with="Saving…">Save connection</.button>
      </div>
    </.form>
  </.dialog>
  <.dialog
    :if={@file_details}
    id="file-details-dialog"
    title={@file_details.filename}
    description="Private file details. Download links require sign-in and file access."
  >
    <img
      :if={display_variant(@file_details)}
      src={~p"/files/#{@file_details.id}/variants/display_webp"}
      alt={@file_details.filename}
      class="mb-5 max-h-72 w-full rounded-lg bg-muted object-contain"
    />
    <div
      :if={!display_variant(@file_details)}
      class="mb-5 flex h-32 items-center justify-center rounded-lg bg-muted"
    >
      <.icon name="hero-document" class="size-12 text-muted-foreground" />
    </div>
    <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 gap-y-3 text-sm">
      <dt class="text-muted-foreground">Size</dt><dd>{format_bytes(@file_details.size)}</dd>
      <dt class="text-muted-foreground">Type</dt><dd class="break-all">
        {@file_details.content_type}
      </dd>
      <dt class="text-muted-foreground">Uploaded</dt><dd>
        {Calendar.strftime(@file_details.created_at, "%d %b %Y · %H:%M UTC")}
      </dd>
      <dt class="text-muted-foreground">Dimensions</dt><dd>
        {if @file_details.width,
          do: "#{@file_details.width} × #{@file_details.height} px (source)",
          else: "Not available"}
      </dd>
      <dt class="text-muted-foreground">Storage</dt><dd>
        {storage_label(@connections, @file_details.connection_id)}
      </dd>
      <dt class="text-muted-foreground">Processing</dt><dd>{@file_details.processing_state}</dd>
      <dt class="text-muted-foreground">Tags</dt><dd class="flex flex-wrap gap-1">
        <.badge :for={tag <- @file_details.tags}>{tag}</.badge><span :if={
          @file_details.tags == []
        }>No tags</span>
      </dd>
    </dl>
    <div class="mt-6 flex gap-2">
      <.button href={~p"/files/#{@file_details.id}/download"}><.icon name="hero-arrow-down-tray" />Download original</.button>
    </div>
  </.dialog>
  <.dialog
    :if={@bulk_dialog == "delete"}
    id="bulk-delete-dialog"
    title="Delete selected files?"
    description={"Permanently delete #{MapSet.size(@selected_files)} files from their original storage? Failed deletions retain their metadata and can be retried."}
  >
    <div class="flex justify-end gap-2">
      <.button type="button" variant="outline" phx-click="close_dialog">Cancel</.button><.button
        id="confirm-bulk-delete"
        type="button"
        variant="destructive"
        phx-click="confirm_bulk_delete"
        phx-disable-with="Deleting…"
      >Delete selected files</.button>
    </div>
  </.dialog>
  <.dialog
    :if={@bulk_dialog == "tags"}
    id="bulk-tags-dialog"
    title="Edit selected file tags"
    description="Changes apply to selected files. One tag per line; up to 20 tags per file."
  >
    <.form for={to_form(%{})} id="bulk-tags-form" phx-submit="bulk_tags" class="space-y-4">
      <.select
        id="bulk-tags-mode"
        name="mode"
        label="Operation"
        value="add"
        options={[
          {"Add tags", "add"},
          {"Remove matching tags", "remove"},
          {"Replace all tags", "replace"}
        ]}
      />
      <.input
        id="bulk-tags-input"
        type="textarea"
        name="tags"
        label="Tags"
        value=""
        rows="5"
        maxlength="6000"
      />
      <p class="text-xs text-muted-foreground">
        Replace with an empty list clears all tags. Tag matching ignores case.
      </p>
      <.button id="apply-bulk-tags" phx-disable-with="Saving…">Apply to selected files</.button>
    </.form>
  </.dialog>
  <.dialog
    :if={@editing_file}
    id="edit-file-tags-dialog"
    title="Edit file tags"
    description={"One tag per line for " <> @editing_file.filename <> ". Tags are trimmed, deduplicated, and limited to 20 tags of 64 characters."}
  >
    <.form
      for={to_form(%{}, as: :file_tags)}
      id="edit-file-tags-form"
      phx-submit="save_file_tags"
      class="space-y-4"
    >
      <.input
        name="tags"
        type="textarea"
        label="Tags"
        id="file-tags-textarea"
        value={@file_tags_input}
        rows="8"
        placeholder="report\nfinance\nq4"
      />
      <p class="text-xs text-muted-foreground">
        Leave blank to remove all tags. No stored file bytes are modified.
      </p>
      <div class="flex justify-end gap-2">
        <.button type="button" variant="outline" phx-click="close_dialog">Cancel</.button><.button id="save-file-tags">Save tags</.button>
      </div>
    </.form>
  </.dialog>

  <.dialog
    :if={@deleting_file}
    id="delete-file-dialog"
    title="Delete this file?"
    description={"Permanently delete " <> @deleting_file.filename <> " from its original storage location?"}
  >
    <div class="flex justify-end gap-2">
      <.button variant="outline" phx-click="close_dialog">Cancel</.button><.button
        id="confirm-delete-file"
        variant="destructive"
        phx-click="confirm_delete_file"
      >Delete file</.button>
    </div>
  </.dialog>
</Layouts.app>
