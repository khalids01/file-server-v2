<Layouts.app flash={@flash}>
  <section class="mx-auto grid max-w-6xl items-center gap-14 px-6 py-20 sm:py-28 lg:grid-cols-2 lg:px-8">
    <div>
      <.badge>
        <span class="size-1.5 rounded-full bg-foreground"></span>
        Your infrastructure. Your control.
      </.badge>
      <h1 class="mt-7 text-5xl font-semibold leading-[1.08] tracking-[-0.05em] sm:text-6xl lg:text-7xl">
        Your files.<br /><span class="text-muted-foreground">Your rules.</span>
      </h1>
      <p class="mt-6 max-w-md text-base leading-8 text-muted-foreground">
        A simpler foundation for your self-hosted file platform. User-owned applications, scoped access, and secure sign-in — without another password.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <.button id="landing-get-started" href="/register">Get started
        <.icon name="hero-arrow-right" class="size-4" /></.button>
        <.button href="/dashboard" variant="outline">Open dashboard</.button>
      </div>
      <div class="mt-7 flex gap-5 text-xs text-muted-foreground">
        <span>Open source</span><span>Self hosted</span><span>Passwordless</span>
      </div>
    </div>
    <div class="rounded-2xl border border-border bg-muted/40 p-4 sm:p-6">
      <.card class="overflow-hidden">
        <div class="flex items-center justify-between border-b border-border px-5 py-4">
          <span class="flex items-center gap-2 text-sm font-medium"><.icon
            name="hero-server-stack"
            class="size-4"
          />File Server</span><span class="text-xs text-muted-foreground">Workspace preview</span>
        </div>
        <div class="p-6">
          <div class="flex items-center justify-between">
            <h2 class="font-semibold tracking-tight">Everything in its place.</h2><.icon
              name="hero-ellipsis-horizontal"
              class="size-4 text-muted-foreground"
            />
          </div>
          <p class="mt-2 text-sm text-muted-foreground">Clear boundaries for every project.</p>
          <div
            :for={
              {name, detail, icon} <- [
                {"Your applications", "Your projects, isolated by default",
                 "hero-building-office-2"},
                {"Applications", "Separate access for each integration", "hero-code-bracket"},
                {"Access keys", "Explicit scopes and revocation", "hero-key"}
              ]
            }
            class="mt-4 flex items-center gap-3 rounded-lg border border-border p-3.5"
          >
            <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted"><.icon
              name={icon}
              class="size-4"
            /></span><div>
              <h3 class="text-sm font-medium">{name}</h3><p class="mt-1 text-xs text-muted-foreground">
                {detail}
              </p>
            </div><.icon name="hero-chevron-right" class="ml-auto size-3.5 text-muted-foreground" />
          </div>
          <div class="mt-6 flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Authentication & applications MVP</span><.badge>
              v2
            </.badge>
          </div>
        </div>
      </.card>
    </div>
  </section>
  <section class="border-y border-border bg-card px-6 py-14">
    <div class="mx-auto grid max-w-6xl gap-8 sm:grid-cols-3">
      <div :for={
        {icon, title, text} <- [
          {"hero-finger-print", "Two ways in. No passwords.",
           "Continue with GitHub or a one-time code delivered to your inbox."},
          {"hero-building-office-2", "Projects stay separate.",
           "Workspace boundaries are enforced on the server, not just in the interface."},
          {"hero-adjustments-horizontal", "Access stays intentional.",
           "Issue scoped application keys with an expiry. Revoke them when you're done."}
        ]
      }>
        <span class="mb-4 flex size-9 items-center justify-center rounded-lg border border-border bg-background"><.icon
          name={icon}
          class="size-4"
        /></span><h2 class="text-sm font-semibold">{title}</h2><p class="mt-2 text-sm leading-7 text-muted-foreground">
          {text}
        </p>
      </div>
    </div>
  </section>
  <footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-xs text-muted-foreground">
    <span>File Server · Built for ownership.</span><span>File storage & v1 migration are on the roadmap.</span>
  </footer>
</Layouts.app>
