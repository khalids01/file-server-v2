<Layouts.auth flash={@flash}>
  <div class="mb-7 text-center">
    <span class="mx-auto mb-5 flex size-11 items-center justify-center rounded-xl border border-border bg-muted/50"><.icon
      name="hero-server-stack"
      class="size-5"
    /></span>
    <h1 class="text-2xl font-semibold tracking-tight">Welcome to File Server</h1>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">
      Sign in or create your account. No passwords.
    </p>
  </div>
  <.button
    :if={@github?}
    id="github-sign-in"
    href="/auth/user/github"
    variant="outline"
    class="w-full"
  >
    <.icon name="hero-code-bracket" class="size-4" />Continue with GitHub
  </.button>
  <.button
    :if={!@github?}
    id="github-unavailable"
    variant="outline"
    class="w-full"
    disabled
    title="GitHub OAuth credentials have not been configured"
  >GitHub unavailable</.button>
  <div class="my-6 flex items-center gap-3 text-[11px] text-muted-foreground">
    <span class="h-px flex-1 bg-border"></span>OR CONTINUE WITH EMAIL<span class="h-px flex-1 bg-border"></span>
  </div>
  <.form for={to_form(%{}, as: :email)} id="otp-request" action="/sign-in/otp" class="space-y-4">
    <.input
      id="sign-in-email"
      name="email"
      type="email"
      label="Email address"
      placeholder="you@example.com"
      autocomplete="email"
      maxlength="254"
      required
    />
    <.button type="submit" class="w-full">Send one-time code
    <.icon name="hero-arrow-right" class="size-4" /></.button>
  </.form>
  <p class="mt-5 text-center text-xs leading-5 text-muted-foreground">
    We'll send a six-digit code to your inbox.<br />It expires in 10 minutes.
  </p>
</Layouts.auth>
