<Layouts.auth flash={@flash}>
  <h1 class="text-2xl font-semibold tracking-tight">Sign in with email</h1>
  <p class="mb-6 mt-2 text-sm leading-6 text-muted-foreground">
    A one-time code. No password to remember.
  </p>
  <.form for={to_form(%{})} id="otp-request" action="/sign-in/otp" class="space-y-4">
    <.input
      id="otp-email"
      name="email"
      type="email"
      label="Email address"
      placeholder="you@example.com"
      autocomplete="email"
      maxlength="254"
      required
    />
    <.button type="submit" class="w-full">Send one-time code</.button>
  </.form>
  <.link
    href="/sign-in"
    class="mt-6 block text-center text-sm text-muted-foreground hover:text-foreground"
  >Back to sign in</.link>
</Layouts.auth>
