<Layouts.app flash={@flash} current_user={@current_user} section="Storage">
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold">Storage</h1><p class="mt-2 text-sm text-muted-foreground">
        Browse your applications’ private local drives and S3 buckets.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <.button navigate={~p"/dashboard/files"} variant="outline">Manage files</.button>
      <.button id="storage-connect-s3" phx-click="new_storage"><.icon name="hero-plus" />Connect S3 storage</.button>
    </div>
  </div>
  <p class="mb-6 text-sm text-muted-foreground">
    Connect S3 storage here and browse your applications’ private storage. Object browsing is read-only; connection testing is available in application settings.
  </p>
  <p :if={@error} id="storage-browser-error" role="alert" class="mb-4 text-destructive">
    {@error}
  </p>
  <div :if={!@drive_id} id="storage-drives" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <p :if={@drives == []} id="storage-drives-empty">
      Create an application to start using storage.
    </p>
    <.card :for={drive <- @drives} id={"storage-drive-#{drive.id}"} class="min-w-0 p-6">
      <h2 class="break-all font-semibold">{drive.name}</h2>
      <p class="my-3 break-all text-sm text-muted-foreground">
        {drive.application_name} · {if drive.type == :local, do: "Local", else: "S3-compatible"}
      </p>
      <div class="flex flex-wrap gap-2">
        <.button navigate={browse_path(drive.id, "")}>Browse</.button><.button
          navigate={~p"/dashboard/applications/#{drive.application_id}"}
          variant="outline"
        >Storage settings</.button>
      </div>
    </.card>
  </div>
  <.card :if={@drive_id} class="p-5 sm:p-7">
    <div class="mb-5 flex flex-wrap gap-3">
      <.button navigate={~p"/dashboard/storage"} variant="outline">All drives</.button><.button
        :if={@prefix != ""}
        patch={browse_path(@drive_id, parent(@prefix))}
        variant="outline"
        id="storage-up"
      >Up</.button><.button
        phx-click="refresh"
        phx-disable-with="Refreshing…"
        variant="outline"
        id="storage-refresh"
      >Refresh</.button>
    </div>
    <p :if={@loading} id="storage-loading" role="status">Loading objects…</p>
    <div :if={@page}>
      <h2 class="break-all font-semibold">{@page.drive.name} · {@page.drive.application_name}</h2>
      <p class="my-3 break-all text-sm text-muted-foreground">/{@page.prefix}</p>
      <p :if={@page.entries == []} id="storage-objects-empty">No objects in this folder.</p>
      <div id="storage-objects" class="divide-y divide-border">
        <div
          :for={entry <- @page.entries}
          class="flex min-w-0 flex-wrap items-center justify-between gap-3 py-3"
        >
          <.link
            :if={entry.type == :folder}
            patch={browse_path(@drive_id, @prefix <> entry.name)}
            class="break-all text-primary underline"
          >{entry.name}</.link>
          <span :if={entry.type == :file} class="min-w-0 break-all text-sm">{entry.name}</span>
          <span class="text-xs text-muted-foreground">{if entry.type == :file,
            do: "#{entry.size} bytes",
            else: "Folder"}</span>
        </div>
      </div>
      <.button
        :if={@page.next_cursor}
        id="storage-next"
        patch={browse_path(@drive_id, @prefix, @page.next_cursor)}
        variant="outline"
        class="mt-5"
      >Next page</.button>
    </div>
  </.card>
  <.dialog
    :if={@show_storage}
    id="storage-connect-dialog"
    title="Connect S3 storage"
    description="Connect IDrive e2, Amazon S3, R2 or another S3-compatible provider. The bucket must already exist."
  >
    <div :if={!Enum.any?(@drives, &(&1.type == :local))} id="storage-connect-no-app">
      <p class="mb-4 text-sm text-muted-foreground">
        Create an application first to give this storage connection an owner application.
      </p>
      <.button navigate={~p"/dashboard/applications"}>Create an application</.button>
      <.button variant="outline" phx-click="close_storage">Cancel</.button>
    </div>
    <.form
      :if={Enum.any?(@drives, &(&1.type == :local))}
      for={@storage_form}
      id="storage-connect-form"
      phx-submit="create_storage"
      class="space-y-4"
    >
      <p
        :if={@storage_error}
        id="storage-connect-error"
        role="alert"
        class="text-sm text-destructive"
      >
        {@storage_error}
      </p>
      <.input
        field={@storage_form[:application_id]}
        type="select"
        label="Application"
        required
        options={[
          {"Choose application", ""}
          | for(
              drive <- @drives,
              drive.type == :local,
              do: {drive.application_name, drive.application_id}
            )
        ]}
      />
      <.input
        field={@storage_form[:name]}
        label="Connection name"
        placeholder="My IDrive bucket"
        required
        minlength="2"
        maxlength="80"
      />
      <.input
        field={@storage_form[:endpoint]}
        label="Endpoint"
        placeholder="https://s3.ap-northeast-1.idrivee2.com"
        required
      />
      <div class="grid gap-4 sm:grid-cols-2">
        <.input field={@storage_form[:bucket]} label="Bucket" required />
        <.input
          field={@storage_form[:region]}
          label="Region"
          placeholder="ap-northeast-1"
          required
        />
      </div>
      <.input name="storage[access_key_id]" label="Access key ID" autocomplete="off" required />
      <.input
        name="storage[secret_access_key]"
        label="Secret access key"
        type="password"
        autocomplete="off"
        required
      />
      <p class="text-sm text-muted-foreground">
        Credentials are encrypted. Saving adds the connection here; choose it in application settings to use it for new uploads. Path-style requests are used.
      </p>
      <div class="flex justify-end gap-2">
        <.button type="button" variant="outline" phx-click="close_storage">Cancel</.button>
        <.button id="storage-save-connection" phx-disable-with="Saving…">Save connection</.button>
      </div>
    </.form>
  </.dialog>
</Layouts.app>
