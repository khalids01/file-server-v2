<Layouts.app
  flash={@flash}
  current_user={@current_user}
  section={section(@live_action)}
  tenant_id={@tenant.id}
>
  <div class="mb-9 flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-indigo-600">
        {@tenant.name}
      </p><h1 class="text-3xl font-semibold tracking-tight">{section(@live_action)}</h1>
    </div>
    <.form for={to_form(%{})} id="tenant-switcher" phx-change="switch_tenant" class="min-w-56">
      <.input
        name="tenant"
        type="select"
        label="Active workspace"
        value={@tenant.id}
        options={Enum.map(@tenants, &{&1.name, &1.id})}
      />
    </.form>
  </div>

  <section :if={@live_action == :overview}>
    <div class="grid gap-4 sm:grid-cols-3">
      <div
        :for={
          {title, value, icon} <- [
            {"Your workspaces", length(@tenants), "hero-building-office-2"},
            {"Applications in view", length(@applications), "hero-command-line"},
            {"Account status", "Verified", "hero-check-badge"}
          ]
        }
        class="rounded-2xl border border-slate-200 bg-white p-6"
      >
        <div class="flex items-center justify-between text-sm text-slate-500">
          {title}<.icon name={icon} class="size-5 text-indigo-400" />
        </div><p class="mt-5 text-3xl font-semibold tracking-tight">{value}</p>
      </div>
    </div>
    <div class="mt-7 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-7">
        <span class="mb-5 flex size-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"><.icon
          name="hero-rocket-launch"
          class="size-6"
        /></span><h2 class="text-xl font-semibold">Build your first connection.</h2><p class="mt-3 text-sm leading-7 text-slate-500">
          Create an application, issue an access key, and test its tenant-bound identity endpoint. Your keys stay scoped to this workspace.
        </p><.link
          navigate={workspace_path(:applications, @tenant.id)}
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600"
        >Manage applications <.icon name="hero-arrow-right" class="size-4" /></.link>
      </div>
      <div class="rounded-2xl border border-dashed border-slate-300 p-7">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">
          Next on the roadmap
        </p><h2 class="mt-5 text-xl font-semibold">A home for your files.</h2><p class="mt-3 text-sm leading-7 text-slate-500">
          Local & S3 storage, file browsing, transfers, backups, and v1 migration are not implemented in this foundation release. There are no demo storage statistics here.
        </p>
      </div>
    </div>
  </section>

  <section :if={@live_action == :applications} class="space-y-7">
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <h2 class="mb-5 text-lg font-semibold">Create an application</h2>
      <.form
        for={to_form(%{}, as: :application)}
        id="create-application"
        phx-submit="create_application"
        class="grid items-end gap-4 sm:grid-cols-[1fr_1fr_auto]"
      >
        <.input
          name="application[name]"
          label="Name"
          required
          minlength="2"
          maxlength="80"
          placeholder="My project"
        />
        <.input
          name="application[slug]"
          label="Slug"
          required
          pattern="[a-z0-9]+(-[a-z0-9]+)*"
          minlength="2"
          maxlength="60"
          placeholder="my-project"
        />
        <.button class="mb-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700">Create application</.button>
      </.form>
    </div>
    <div id="applications" phx-update="stream" class="space-y-3">
      <p
        id="applications-empty"
        class="hidden rounded-2xl border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500 only:block"
      >
        No applications yet. Give your next project a workspace.
      </p>
      <div
        :for={{dom_id, app} <- @streams.applications}
        id={dom_id}
        class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-5"
      >
        <div class="flex items-center gap-4">
          <span class="flex size-11 items-center justify-center rounded-xl bg-slate-100"><.icon
            name="hero-code-bracket"
            class="size-5 text-slate-600"
          /></span><div>
            <h3 class="font-semibold">{app.name}</h3><p class="mt-1 text-xs text-slate-400">
              {app.slug}
            </p>
          </div>
        </div>
        <.button
          phx-click="select_app"
          phx-value-id={app.id}
          class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-600 hover:border-indigo-300 hover:text-indigo-600"
        >Manage keys</.button>
      </div>
    </div>
    <div
      :if={@selected_app}
      id="application-keys"
      class="rounded-2xl border border-slate-200 bg-white p-6"
    >
      <h2 class="text-lg font-semibold">Access keys · {@selected_app.name}</h2><p class="mt-2 text-sm text-slate-500">
        Server-side credentials. Keys expire after 30 days. Maximum 100 recent keys shown.
      </p>
      <.form
        for={to_form(%{}, as: :key)}
        id="issue-key"
        phx-submit="issue_key"
        class="mt-6 grid items-end gap-4 sm:grid-cols-[1fr_1fr_auto]"
      >
        <.input
          name="key[name]"
          label="Key name"
          required
          minlength="2"
          maxlength="80"
          placeholder="Development"
        />
        <.input
          name="key[access]"
          label="Access"
          type="select"
          options={[
            {"Read only", "read"},
            {"Read & write", "write"},
            {"Read, write & delete", "manage"}
          ]}
        />
        <.button class="mb-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-600">Issue key</.button>
      </.form>
      <div
        :if={@plaintext_key}
        id="new-api-key"
        class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4"
      >
        <p class="mb-2 text-xs font-semibold text-amber-800">
          Copy now. This is the only time the complete key is displayed.
        </p><code class="block break-all select-all text-sm text-amber-950">{@plaintext_key}</code>
      </div>
      <div id="keys" phx-update="stream" class="mt-6 space-y-2">
        <div
          :for={{dom_id, key} <- @streams.keys}
          id={dom_id}
          class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 py-4"
        >
          <div>
            <p class="text-sm font-semibold">
              {key.name}
              <span class="font-mono text-xs font-normal text-slate-400">…{key.fingerprint}</span>
            </p><p class="mt-1 text-xs text-slate-400">
              {Enum.join(key.scopes, ", ")} · {if key.revoked_at,
                do: "Revoked",
                else: "Expires " <> Calendar.strftime(key.expires_at, "%d %b %Y")}
            </p>
          </div><.button
            :if={!key.revoked_at}
            phx-click="revoke_key"
            phx-value-id={key.id}
            data-confirm="Revoke this key? Integrations using it will stop working."
            class="rounded-lg px-3 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50"
          >Revoke</.button>
        </div>
      </div>
      <p class="mt-5 text-xs leading-6 text-slate-400">
        Test with <code>GET /api/v2/application</code>
        and <code>Authorization: Bearer &lt;key&gt;</code>. File endpoints will arrive with the storage milestone.
      </p>
    </div>
  </section>

  <section :if={@live_action == :settings} class="max-w-2xl space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-7">
      <h2 class="text-lg font-semibold">Current workspace</h2><dl class="mt-5 space-y-3 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">Name</dt><dd>{@tenant.name}</dd>
        </div><div class="flex flex-wrap justify-between gap-4">
          <dt class="text-slate-500">Workspace ID</dt><dd class="font-mono text-xs">
            {@tenant.id}
          </dd>
        </div>
      </dl><p class="mt-6 text-xs leading-6 text-slate-400">
        Member invitations, granular application grants, and storage settings are planned. This MVP provides owner-isolated workspaces.
      </p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-7">
      <h2 class="mb-5 text-lg font-semibold">Create another workspace</h2><.form
        for={to_form(%{}, as: :workspace)}
        id="create-workspace"
        phx-submit="create_workspace"
        class="space-y-4"
      >
        <.input
          name="workspace[name]"
          label="Workspace name"
          required
          minlength="2"
          maxlength="80"
        /><.button class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700">Create workspace</.button>
      </.form>
    </div>
  </section>

  <section :if={@live_action == :profile} class="max-w-2xl space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-7">
      <h2 class="mb-5 text-lg font-semibold">Your profile</h2><.form
        for={to_form(%{"name" => @current_user.name}, as: :profile)}
        id="profile-form"
        phx-submit="update_profile"
        class="space-y-4"
      >
        <.input
          name="profile[name]"
          label="Display name"
          value={@current_user.name}
          maxlength="80"
        /><p class="text-sm text-slate-500">{to_string(@current_user.email)} · Email verified</p><.button class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700">Save profile</.button>
      </.form>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-7">
      <h2 class="text-lg font-semibold">Account security</h2><p class="mt-3 text-sm leading-7 text-slate-500">
        Use an emailed reset link to set or change your password. GitHub account linking and a session manager are deferred; sign-in methods never automatically merge existing accounts.
      </p><.link
        href="/forgot-password"
        class="mt-5 inline-block text-sm font-semibold text-indigo-600"
      >Request password reset →</.link>
    </div>
  </section>
</Layouts.app>
